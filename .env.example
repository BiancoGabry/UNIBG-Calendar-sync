EASYSTAFF_BASE_URL=https://logistica.unibg.it/PortaleStudenti/
# User-Agent inviato al portale: metti un tuo contatto
EASYSTAFF_USER_AGENT=unibg-calendar-sync/1.0 (+tua-email@example.com)

# Chiave JSON del service account Google: percorso del file (consigliato, fuori dal repo)...
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./secrets/google-service-account.json
# ...oppure tutto il JSON su una riga (grezzo o in base64). Se ci sono entrambi vince il file.
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Password della UI: in chiaro (viene hashata con bcrypt in memoria) oppure hash bcrypt.
# Per l'hash usa `pnpm hash-password`: ti stampa la forma giusta per `pnpm dev` e per Docker.
APP_PASSWORD=
# Almeno 32 caratteri: openssl rand -base64 48
SESSION_SECRET=
# Per POST /api/sync (cron esterno): openssl rand -hex 24
CRON_SECRET=

# In Docker viene sovrascritto con file:/data/unibg.db
DATABASE_URL=file:./data/unibg.db
SYNC_CRON=*/15 * * * *
COMBO_CRON=0 6 * * *
# Tra le 00:00 e le 06:00 sincronizza solo una volta l'ora
NIGHT_HOURLY=true
TZ=Europe/Rome
LOG_LEVEL=info
